<Project>

  <!-- Makes .editorconfig rules fail the build. API only: the generated WorkerExtensions project isn't ours. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FrostWoodTech.API'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

</Project>
