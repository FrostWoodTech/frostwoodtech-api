{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "<azure-web-jobs-storage>",
    "FUNCTIONS_WORKER_RUNTIME": "<functions-worker-runtime>"
  },
  "Host": {
    "CORS": "<comma-separated-cors-allowed-origins, must match Cors:AllowedOrigins below - only func.exe reads this, for local preflight handling>",
    "CORSCredentials": true
  },
  "Jwt": {
    "Signer": "<a-long-random-secret-at-least-32-chars>",
    "Issuer": "<jwt-issuer>",
    "Audience": "<jwt-audience>",
    "AccessTokenMinutes": "<jwt-access-token-minutes>",
    "RefreshTokenDays": "<jwt-refresh-token-days>"
  },
  "SuperAdmin": {
    "Email": "<super-admin-email>",
    "FirstName": "<super-admin-first-name>",
    "LastName": "<super-admin-last-name>"
  },
  "NeonS3": {
    "Endpoint": "<neon-s3-endpoint>",
    "AccessKey": "<neon-s3-access-key>",
    "SecretKey": "<neon-s3-secret-key>",
    "Region": "<neon-s3-region>",
    "BucketName": "<neon-s3-bucket-name>"
  },
  "Google": {
    "ClientId": "<google-oauth-client-id>.apps.googleusercontent.com"
  },
  "Email": {
    "Provider": "brevo",
    "FromAddress": "<no-reply@your-domain>",
    "FromName": "<email-from-name>",
    "ApiKey": "<brevo-api-key>",
    "BaseUrl": "<email-base-url>"
  },
  "Docs": {
    "Enabled": "<docs-enabled>"
  },
  "Contact": {
    "NotifyAddress": "<address for new contact-form submissions; falls back to SuperAdmin:Email>"
  },
  "ExchangeRate": {
    "BaseUrl": "<optional; defaults to the free open.er-api.com endpoint, override only to point at a different FX provider>"
  },
  "Cors": {
    "AllowedOrigins": "<comma-separated-cors-allowed-origins>"
  },
  "ConnectionStrings": {
    "Default": "<connection-string>"
  }
}
